21:27:34Z","horizon_days":21,"hours":72,"next_event":{"at":"2026-11-15T23:50:00Z","date_only":false,"economy":"jp","event_key":"jp-gdp:2026-11-16","name":"日本季度 GDP 速報","official_url":"https://www.esri.cao.go.jp/en/sna/kouhyou/kouhyou_top.html","scheduled_at":"2026-11-15T23:50:00Z","tier":1},"next_key_event":{"at":"2026-11-15T23:50:00Z","date_only":false,"economy":"jp","event_key":"jp-gdp:2026-11-16","name":"日本季度 GDP 速報","official_url":"https://www.esri.cao.go.jp/en/sna/kouhyou/kouhyou_top.html","scheduled_at":"2026-11-15T23:50:00Z","tier":1},"visible_event_keys":["jp-gdp:2026-11-16","cn-activity:2026-11-16","ca-cpi:2026-11-16","au-rba-minutes:2026-11-17","uk-labour-market:2026-11-17","us-retail-sales:2026-11-17"]},"policy_divergence":{"cuts":[],"hikes":["boe","boc","rba","riksbank"],"holds":["fed","ecb","boj","snb","norges"],"unknown":["pboc"],"window_days":90},"rate_pulse":{"bank":"boe","change_bp":25,"cuts":[],"date":"2026-11-05","hikes":["boe","boc","rba","riksbank"],"holds":["fed","ecb","boj","snb","norges"],"rate":"4.00%","url":"https://www.bankofengland.co.uk/monetary-policy-summary-and-minutes/2026/november-2026"}},"review_by":"2026-12-08","sources":[{"label":"加拿大央行 10-28","url":"https://www.bankofcanada.ca/2026/10/fad-press-release-2026-10-28/"},{"label":"澳洲聯儲 11-03","url":"https://www.rba.gov.au/media-releases/2026/mr-26-30.html"},{"label":"瑞典央行 11-04","url":"https://www.riksbank.se/en-gb/press-and-published/notices-and-press-releases/press-releases/2026/policy-rate-raised-to-2-per-cent/"},{"label":"英國央行 11-05","url":"https://www.bankofengland.co.uk/monetary-policy-summary-and-minutes/2026/november-2026"},{"label":"美國 10 月 CPI","url":"https://www.bls.gov/news.release/archives/cpi_11102026.htm"}]},"schema_version":2,"statement_highlights":{"banks":[{"attribution":"英國央行原文，經節選","bank":"boe","checked_at":"2026-11-14T06:00:00Z","decision":"上調 25 個基點至 4.00%","detail":"投票比 8–1，1 名委員主張直接升息 50bp 至 4.25%（上次為 6–3 維持）；會前英國央行市場參與者調查的中位數預期即為 4.00%。","detail_url":"https://www.bankofengland.co.uk/monetary-policy-summary-and-minutes/2026/november-2026","highlights":[{"new_en":"The Committee will adjust Bank Rate as necessary to ensure CPI inflation returns to the 2% target in the medium term.","old_en":"The Committee stands ready to act as necessary to ensure that CPI inflation remains on track to meet the 2% target in the medium term.","spans":[{"kind":"equal","text":"The Committee"},{"kind":"removed","text":"stands ready to act"},{"kind":"added","text":"will adjust Bank Rate"},{"kind":"equal","text":"as necessary to ensure"},{"kind":"removed","text":"that"},{"kind":"equal","text":"CPI inflation"},{"kind":"removed","text":"remains on track"},{"kind":"added","text":"returns"},{"kind":"equal","text":"to"},{"kind":"removed","text":"meet"},{"kind":"equal","text":"the 2% target in the medium term."}],"subtext":"“隨時準備行動”升級為“將按需調整利率”，“保持在目標路徑”改為“回到目標”，等於承認通膨偏離；後續每次會議都可能再動。","zh":"委員會將視需要調整 Bank Rate，確保 CPI 通膨在中期回到 2% 的目標。"},{"new_en":"However, the degree of inflationary pressure in the pipeline is now sufficient to warrant an increase in Bank Rate.","old_en":"However, the risk of such effects, against which policy needs to lean, is greater the longer higher energy prices persist or are more volatile.","spans":[{"kind":"equal","text":"However, the"},{"kind":"removed","text":"risk of such effects, against which policy needs to lean, is greater the longer higher energy prices persist or are more volatile."},{"kind":"added","text":"degree of inflationary pressure in the pipeline is now sufficient to warrant an increase in Bank Rate."}],"subtext":"上次只說風險越拖越大、政策需要頂住；這次直接認定在途的通膨壓力“已足以”支持升息。從警告到行動，鷹派轉向寫進了正文。","zh":"不過，正在傳導中的通膨壓力，其程度現已足以支持上調 Bank Rate。"}],"name":"英國央行","new_date":"2026-11-05","old_date":"2026-09-17","old_source_url":"https://www.bankofengland.co.uk/monetary-policy-summary-and-minutes/2026/september-2026","page_url":null,"source_url":"https://www.bankofengland.co.uk/monetary-policy-summary-and-minutes/2026/november-2026"},{"attribution":"聯準會聲明原文","bank":"fed","checked_at":"2026-11-14T06:00:00Z","decision":"維持 3.75%–4.00%","detail":"投票比 10–2，庫克與哈馬克主張本次再升息 25bp（9 月 16 日剛升息 25bp）。","detail_url":"https://www.federalreserve.gov/newsevents/pressreleases/monetary20261028a.htm","highlights":[{"new_en":"The accumulation of more information will help the Committee determine the policy stance appropriate to ensure a timely return of inflation to the Committee's 2 percent goal.","old_en":"Today's policy action will support a timelier return to the Committee's 2 percent goal.","spans":[{"kind":"removed","text":"Today's policy action will support a timelier return"},{"kind":"added","text":"The accumulation of more information will help the Committee determine the policy stance appropriate to ensure a timely return of inflation"},{"kind":"equal","text":"to the Committee's 2 percent goal."}],"subtext":"從“本次行動”改為“積累更多資訊”，是暫停的訊號，但並未承諾停止升息；12 月是否再動，看屆時的通膨與就業數據。","zh":"更多資訊的積累將幫助委員會確定合適的政策立場，以確保通膨及時回到委員會 2% 的目標。"},{"new_en":"Economic activity is expanding at a strong pace.","old_en":"Economic activity is expanding at a solid pace.","spans":[{"kind":"equal","text":"Economic activity is expanding at a"},{"kind":"removed","text":"solid"},{"kind":"added","text":"strong"},{"kind":"equal","text":"pace."}],"subtext":"對經濟的評價由“穩健”上調為“強勁”，說明暫停不是因為增長轉弱；這只是增長評估一處用詞的變化，偏鷹但分量有限。","zh":"經濟活動正以強勁的步伐擴張。"}],"name":"聯準會","new_date":"2026-10-28","old_date":"2026-09-16","old_source_url":"https://www.federalreserve.gov/newsevents/pressreleases/monetary20260916a.htm","page_url":"https://heronatlas.com/zh-hant/central-banks/fed/2026-10-28/","source_url":"https://www.federalreserve.gov/newsevents/pressreleases/monetary20261028a.htm"},{"attribution":"來源：澳洲聯儲 2026，經節選（CC BY 4.0）","bank":"rba","checked_at":"2026-11-14T06:00:00Z","decision":"上調 25 個基點至 4.85%","detail":"投票比 6–3，3 名委員主張維持 4.60%（9 月 29 日的升息決定為一致同意）。","detail_url":"https://www.rba.gov.au/media-releases/2026/mr-26-30.html","highlights":[{"new_en":"The Board will continue to do what it considers necessary to bring inflation sustainably back to target.","old_en":"The Board will continue to do what it considers necessary to bring inflation sustainably back to target, including increasing the cash rate target further if needed.","spans":[{"kind":"equal","text":"The Board will continue to do what it considers necessary to bring inflation sustainably back to"},{"kind":"removed","text":"target, including increasing the cash rate target further if needed."},{"kind":"added","text":"target."}],"subtext":"升息的同時刪掉了“必要時進一步上調現金利率”這半句，再加上 3 票主張不動，說明委員會對繼續升息的共識在減弱，措辭偏鴿。","zh":"委員會將繼續採取其認為必要的措施，使通膨可持續地回到目標。"},{"new_en":"Inflation is now expected to remain above 3 per cent for the coming year and there is an increasing risk that higher inflation expectations will become embedded.","old_en":"The Board remains focused on ensuring that high inflation does not become embedded.","spans":[{"kind":"removed","text":"The Board remains focused on ensuring that high inflation does not"},{"kind":"added","text":"Inflation is now expected to remain above 3 per cent for the coming year and there is an increasing risk that higher inflation expectations will"},{"kind":"equal","text":"become embedded."}],"subtext":"對通膨的判斷卻更重：未來一年通膨料高於 3%，預期固化的風險在上升。刪掉升息承諾不等於收手，後續會議仍看數據。","zh":"目前預計未來一年通膨將保持在 3% 以上，較高的通膨預期變得根深蒂固的風險正在上升。"}],"name":"澳洲聯儲","new_date":"2026-11-03","old_date":"2026-09-29","old_source_url":"https://www.rba.gov.au/media-releases/2026/mr-26-27.html","page_url":null,"source_url":"https://www.rba.gov.au/media-releases/2026/mr-26-30.html"},{"attribution":"歐洲央行原文，經節選","bank":"ecb","checked_at":"2026-11-14T06:00:00Z","decision":"三項關鍵利率維持不變（存款便利利率 2.50%）","detail":"9 月 10 日升息 25bp 後本次按兵不動；聲明未披露投票情況。","detail_url":"https://www.ecb.europa.eu/press/pr/date/2026/html/ecb.mp261029~9a493adf17.en.html","highlights":[{"new_en":null,"old_en":"The conflict in the Middle East continues to generate inflation pressures, and inflation is set to remain well above target for an extended period.","spans":[{"kind":"removed","text":"The conflict in the Middle East continues to generate inflation pressures, and inflation is set to remain well above target for an extended period."}],"subtext":"刪去“通膨將長期遠高於目標”的確定性判斷，但新聲明仍稱能源衝擊可能推高通膨：從下結論退回到提示風險，為按兵不動留出空間。","zh":"中東衝突繼續帶來通膨壓力，通膨將在較長時間內保持在遠高於目標的水平。"},{"new_en":"While the full effects of the energy shock are still unfolding, underlying inflation has remained broadly stable so far and wages do not show a material response at this stage.","old_en":null,"spans":[{"kind":"added","text":"While the full effects of the energy shock are still unfolding, underlying inflation has remained broadly stable so far and wages do not show a material response at this stage."}],"subtext":"新增“基礎通膨到目前為止大體穩定、工資現階段沒有明顯反應”，這是本次暫停的依據；兩處限定語都留了餘地，後續要看工資數據。","zh":"能源衝擊的全部影響仍在顯現，但到目前為止，基礎通膨大體保持穩定，工資現階段也沒有明顯反應。"}],"name":"歐洲央行","new_date":"2026-10-29","old_date":"2026-09-10","old_source_url":"https://www.ecb.europa.eu/press/pr/date/2026/html/ecb.mp260910~314e508016.en.html","page_url":"https://heronatlas.com/zh-hant/central-banks/ecb/2026-10-29/","source_url":"https://www.ecb.europa.eu/press/pr/date/2026/html/ecb.mp261029~9a493adf17.en.html"}],"default_bank":"boe"}}
